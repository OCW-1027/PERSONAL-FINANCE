rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 各ユーザーは自分の uid 配下のみ読み書き可能
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // それ以外は全面拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
